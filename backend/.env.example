JWT_SECRET=your_long_random_secret_here
PORT=3000

# Finance module — reads live budget/category data from a self-hosted Actual Budget server.
# ACTUAL_SYNC_ID is the budget's Sync ID, found in Actual under Settings > Show advanced settings.
ACTUAL_SERVER_URL=http://your-actual-server:5006
ACTUAL_PASSWORD=your_actual_server_password
ACTUAL_SYNC_ID=your_actual_budget_sync_id
# Where the budget cache is stored on disk. Must be a persistent volume so it
# survives container restarts (avoids a full re-download of the budget each boot).
ACTUAL_DATA_DIR=/app/data/actual-cache
