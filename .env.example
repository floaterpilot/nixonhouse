HOST=0.0.0.0
PORT=3000
PUBLIC_URL=https://nixonhouse.com

# Set true when serving over HTTPS in production.
COOKIE_SECURE=true
NIXONHOUSE_SECRET=replace-with-a-long-random-secret

# Defaults target Lakewood Ranch, FL.
WEATHER_LABEL=Lakewood Ranch, FL
WEATHER_LAT=27.459
WEATHER_LON=-82.4247
RADAR_STATION=KTBW
RADAR_URL=https://radar.weather.gov/ridge/standard/KTBW_loop.gif

# Optional Spotify OAuth support. Create an app in the Spotify Developer Dashboard.
# Use https://nixonhouse.com/spotify/callback as the redirect URI in production.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Optional: put runtime JSON somewhere persistent outside the repo.
# NIXONHOUSE_DATA_DIR=/var/lib/nixonhouse
